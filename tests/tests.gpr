with "../opencl_wrapper.gpr";

project OpenCL_Wrapper_Tests is
   for Languages use ("Ada");
   for Source_Dirs use ("smoke");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin/tests";
   for Main use ("smoke_platforms.adb");
   for Create_Missing_Dirs use "True";

   Default_OpenCL_Library : constant String := "OpenCL";
   OpenCL_Library : constant String :=
     External ("OPENCL_LIB_NAME", Default_OpenCL_Library);

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa");
   end Compiler;

   package Linker is
      for Linker_Options ("Ada") use ("-l" & OpenCL_Library);
   end Linker;
end OpenCL_Wrapper_Tests;
