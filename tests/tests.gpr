with "../opencl_wrapper.gpr";

project Tests is
   OpenCL_Link_Flag := external ("OPENCL_LINK_FLAG", "-lOpenCL");

   for Source_Dirs use (".", "smoke");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use
     ("smoke_platforms.adb",
      "smoke_core.adb",
     "gen_pack_add1.adb",
     "smoke_rt_load_pack_add1.adb",
     "smoke_rt_negative_cases.adb",
      "smoke_rt_signature_enforcement.adb",
      "smoke_rt_signature_plugin.adb",
      "smoke_rt_strict_policy.adb",
      "smoke_rt_untrusted_plugin.adb",
      "smoke_buffer_roundtrip.adb",
      "smoke_kernel_add1.adb",
      "smoke_program_binary_roundtrip.adb");

   package Linker is
      for Default_Switches ("Ada") use (OpenCL_Link_Flag);
   end Linker;
end Tests;
