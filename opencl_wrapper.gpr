project OpenCL_Wrapper is
   OpenCL_Link_Flag := external ("OPENCL_LINK_FLAG", "-lOpenCL");

   for Languages use ("Ada");
   for Source_Dirs use
     ("src/opencl", "src/opencl/raw", "src/opencl/core", "src/opencl/rt");
   for Object_Dir use "obj";

   package Linker is
      for Switches ("Ada") use (OpenCL_Link_Flag);
   end Linker;
end OpenCL_Wrapper;
